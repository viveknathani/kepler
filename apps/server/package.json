{
  "name": "server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --env-file ../../.env --hot src/index.ts",
    "start": "bun --env-file ../../.env src/index.ts",
    "migrate:up": "bun --env-file ../../.env src/database/migrate.ts up",
    "migrate:down": "bun --env-file ../../.env src/database/migrate.ts down",
    "migrate:generate": "bun src/database/migrate.ts generate",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.47",
    "@bull-board/api": "^6.20.6",
    "@bull-board/hono": "^6.20.6",
