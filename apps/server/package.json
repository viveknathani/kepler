    "@clerk/backend": "^3.2.2",
    "@langfuse/otel": "^5.0.1",
    "@opentelemetry/sdk-trace-node": "^2.6.0",
    "ai": "^6.0.134",
    "bullmq": "^5.71.0",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.12.8",
    "ioredis": "5.9.3",
    "nanoid": "^5.1.7",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "svix": "^1.89.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/pg": "^8.15.5",
